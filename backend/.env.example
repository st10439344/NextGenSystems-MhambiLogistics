# Copy to ".env" and fill in. NEVER commit ".env".
NODE_ENV=development
PORT=3000

# --- Database (Neon connection string, keep ?sslmode=require) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_SSL=true

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# --- Google Sign-In (leave blank until configured; Google login is then disabled) ---
# Comma-separated list. Use the WEB application client ID (also used as serverClientId in Android).
GOOGLE_CLIENT_IDS=

# --- Email for password reset (leave SMTP_HOST blank: links are only logged in development) ---
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mhambi Logistics <no-reply@example.com>"

# --- Demonstration data (used ONLY by `npm run seed`) ---
# Choose your own password (min 10 chars, upper+lower+digit). It is hashed before storage.
DEMO_SEED_PASSWORD=

# --- Browser CORS (website served from the same backend needs nothing) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
