<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY: lets BlueStacks / a test phone reach a backend running on your PC over plain HTTP (e.g. http://192.168.1.20:3000/api/v1/). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
